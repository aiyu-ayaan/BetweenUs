{
  "name": "docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "prestart": "node ../scripts/sync-changelog.mjs && node ../scripts/build-code-reference.mjs",
    "start": "cross-env NODE_ENV=development docusaurus start",
    "prebuild": "node ../scripts/sync-changelog.mjs && node ../scripts/build-code-reference.mjs",
    "build": "cross-env NODE_ENV=production docusaurus build",
    "sync:changelog": "node ../scripts/sync-changelog.mjs",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "cross-env NODE_ENV=production docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "comment:overrides": [
    "Security patches for transitives of Docusaurus, which is already on its",
    "latest release (3.10.2) - so there is no upstream bump that resolves these",
    "and an override is the only lever. Each is the minimum patched version.",
    "uuid is keyed to the 8.x line on purpose: a bare 'uuid' override would",
    "also drag the unaffected 14.0.2 copy in this tree backwards.",
    "Drop an entry once Docusaurus ships a release that resolves past it."
  ],
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "uuid@^8": "^11.1.1",
    "qs": "^6.16.0",
    "fast-uri": "^3.1.6",
    "svgo": "^3.3.5",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "cross-env": "^10.1.0",
    "typescript": "~6.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}

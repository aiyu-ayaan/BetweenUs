<?xml version="1.0" encoding="utf-8"?>
<!--
    One directory, and only one: photos taken from the attachment sheet, on
    their way into a message. Nothing else in the app's storage is shared, and
    nothing here survives being uploaded - the cache is the right place for a
    file whose whole life is the next few seconds.
-->
<paths>
    <cache-path name="camera" path="camera/" />
    <cache-path name="media" path="media/" />
    <!-- What the crop screen wrote, on its way to the same place. -->
    <cache-path name="edited" path="edited/" />
    <!-- And what the video compressor wrote, likewise. -->
    <cache-path name="outgoing" path="outgoing/" />
    <!-- The picture inside a message notification. The system UI is another
         process and cannot be handed a bitmap, so the decrypted thumbnail is
         written here and granted to it for as long as the notification lives. -->
    <cache-path name="notifications" path="notifications/" />
</paths>

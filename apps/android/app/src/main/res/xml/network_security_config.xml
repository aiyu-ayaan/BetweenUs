<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is permitted because BetweenUs is self-hosted and a great many
  deployments are a box on a LAN reached over plain http - the same addresses
  the desktop client's server picker accepts. Android cannot express "private
  ranges only" here; the domain list is exact hosts or nothing, and a fixed
  list would not contain whichever 192.168.x.x a person actually runs.

  Public deployments go through Cloudflare and are https regardless. See the
  hardening phase in development/ANDROID_TODO.md.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

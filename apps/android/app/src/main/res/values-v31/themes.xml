<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Android 12+: the system splash plays the animated mark - the two faces
         slide in and lean in - on the same near-black ground as the app, so
         the hand-over to the first frame is a change of mark and nothing
         else. See drawable/splash_mark (written by design/brand/build.py). -->
    <style name="Theme.BetweenUs" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowSplashScreenAnimationDuration">900</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!--
  The launcher icon's background layer: the accent, as a gradient.

  Adaptive icons are two layers the launcher masks into whatever shape the
  device uses - a circle, a squircle, a rounded square - and it may parallax
  them against each other. So the background has to be a flat field rather than
  artwork: anything with detail in it gets cropped differently on every phone.

  A gradient rather than one flat colour because a solid accent at this size
  reads as a sticker; the fall to `AccentHover` at the bottom gives it the same
  depth the app's own surfaces have. Both colours are the palette's own - see
  ui/theme/Color.kt, which is the one place they are defined.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#FF8C6FFF" android:offset="0.0" />
                <item android:color="#FF7C5CFF" android:offset="0.5" />
                <item android:color="#FF5B3FE0" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>

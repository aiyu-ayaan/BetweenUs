<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Asked for at the moment they mean something, never on launch. See
         feature/settings/Permissions.kt. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The attachment sheet shows the phone's recent photos inline, which
         means reading them. The system photo picker and the document browser
         are still there and need none of this, so refusing it costs the grid
         and nothing else.

         READ_MEDIA_VISUAL_USER_SELECTED is API 34's "only these photos": it is
         granted where the other two are refused, and MediaStore then returns
         exactly what was picked. Treating it as "no access" would show an
         empty grid to somebody who had just chosen what to share. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"
        tools:ignore="ScopedStorage" />

    <!-- A call has to survive the screen going off, which on Android means a
         foreground service with an ongoing notification saying so. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- And a message with a video attached has to survive the same thing: the
         screen going off, the channel being left, the app being backgrounded.
         Without it Android is entitled to stop the upload halfway, which is
         parts already in object storage and nothing left to finish them. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- A call goes to a headset that is already paired, which needs one
         permission on each side of the API 31 split. BLUETOOTH_CONNECT is the
         runtime one and is asked for with the microphone; the two legacy ones
         are install-time and stop at 30, where BLUETOOTH_CONNECT does not
         exist. Without the right one for the platform, Android reports no
         Bluetooth device at all and the headset cannot be chosen.

         BLUETOOTH_SCAN is deliberately not here. It is for discovering devices
         that are not paired yet, which is the system's Bluetooth settings and
         not this app's business - and it is a dangerous permission, so asking
         for it to route audio would be asking for more than the job needs. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- BetweenUs runs on a phone without either; a tablet with no camera can
         still be in a call and listen. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Declaring the permissions above implies this feature, and implying it
         as required would keep BetweenUs off any device without a radio. -->
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- largeHeap, for attachments. A file goes up sealed, so the plaintext and
         the ciphertext exist at the same time - a hundred megabyte video is two
         hundred megabytes of arrays, which the default heap on a mid-range
         phone does not have. It is asked for because of what this app does with
         one file, not as a way of not thinking about memory. -->
    <application
        android:name=".BetweenUsApp"
        android:allowBackup="true"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BetweenUs">
        <!-- singleTask, because the call notification points here. The default
             launch mode builds a second MainActivity on top of the first, which
             starts a fresh navigation graph on the home screen and destroys the
             one holding the call - so tapping "return to the call" ended it. -->
        <!-- Rotation does not rebuild the activity. Compose reads the new
             configuration on its own, and the rebuild was actively harmful: the
             share stage asks for an orientation while it is open and gives it
             back when it closes, so a recreate meant close, hand back, reopen,
             ask again - a rotation loop that ended in a crash. It also drops
             every video renderer and rebuilds them mid-call for nothing. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.BetweenUs"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Where a provider sign-in comes back to, and where an invite
                 link opens. A private scheme rather than an https app link,
                 because BetweenUs is self-hosted: the deployment's host is not
                 known when this is built, so an https filter would either name
                 a host that is wrong for everybody or claim every https link on
                 the phone. Android does not promise a scheme is ours alone,
                 which is why the sign-in that comes back through it is bound to
                 a secret this app keeps - see OAuthFlow. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="betweenus" />
            </intent-filter>
        </activity>

        <!-- Where a photo taken from the attachment sheet lands. The camera app
             is a different process and cannot be handed a `file://` path, so it
             gets a content URI into our own cache instead. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".feature.voice.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone|camera|mediaProjection" />

        <service
            android:name=".feature.chat.UploadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>

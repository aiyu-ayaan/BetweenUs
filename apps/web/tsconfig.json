{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@nexora/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@nexora/permissions": ["../../packages/permissions/src/index.ts"]
    }
  },
  // The UI itself lives in the desktop tree; this app is its browser entry
  // point. `electron/` is deliberately absent - nothing here builds it.
  "include": ["src", "vite.config.ts", "../desktop/src"]
}

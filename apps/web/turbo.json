{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/desktop/src/**",
        "$TURBO_ROOT$/apps/desktop/public/**",
        "$TURBO_ROOT$/apps/desktop/tailwind.theme.mjs"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/desktop/src/**",
        "$TURBO_ROOT$/apps/desktop/tailwind.theme.mjs"
      ]
    }
  }
}

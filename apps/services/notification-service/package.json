    "@betweenus/logger": "workspace:*",
    "@betweenus/nest-common": "workspace:*",
    "@betweenus/permissions": "workspace:*",
    "@betweenus/shared-types": "workspace:*",
    "@nestjs/common": "^10.4.1",
    "@nestjs/core": "^10.4.1",
    "@nestjs/platform-express": "^10.4.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^13.0.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"

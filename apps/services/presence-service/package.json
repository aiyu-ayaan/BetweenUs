{
  "name": "@betweenus/presence-service",
  "private": true,
  "version": "0.1.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node smoke.mjs",
    "check": "tsx src/voice-lifetime.check.ts && tsx src/last-seen-visibility.check.ts && tsx src/socket-member.check.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "@betweenus/auth": "workspace:*",
    "@betweenus/config": "workspace:*",
    "@betweenus/database": "workspace:*",
    "@betweenus/events": "workspace:*",
    "@betweenus/logger": "workspace:*",
    "@betweenus/permissions": "workspace:*",
    "@betweenus/nest-common": "workspace:*",
    "@betweenus/shared-types": "workspace:*",
    "@betweenus/websocket": "workspace:*",
    "ioredis": "^5.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.10",
    "@types/ws": "^8.5.12",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}

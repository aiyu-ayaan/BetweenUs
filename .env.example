# Copy to .env and adjust. Never commit .env.

# --- Data stores (match docker-compose.dev.yml defaults) ---
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="nexora"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexora?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- Service ports (host dev mode) ---
AUTH_SERVICE_PORT="3001"
USER_SERVICE_PORT="3002"
WORKSPACE_SERVICE_PORT="3003"
CHAT_SERVICE_PORT="3004"
PRESENCE_SERVICE_PORT="3005"
NOTIFICATION_SERVICE_PORT="3006"
CALL_SERVICE_PORT="3007"
REMOTE_GATEWAY_PORT="3008"

# --- Runtime ---
NODE_ENV="development"
LOG_LEVEL="debug"
CORS_ORIGIN="http://localhost:5173"

# --- Desktop renderer (Vite, must be VITE_ prefixed) ---
VITE_API_URL="http://localhost:8080"
VITE_WS_URL="ws://localhost:8080"

# --- File storage ---
# Leave the S3 block empty for local development: uploads then go to
# LOCAL_STORAGE_PATH on disk and are served from /api/v1/uploads.
# Filling in all four S3 variables switches to the bucket automatically.
# STORAGE_DRIVER forces a driver ("local" or "s3"); leave unset for auto.
STORAGE_DRIVER=""
LOCAL_STORAGE_PATH="./storage-data"
LOCAL_STORAGE_PUBLIC_PREFIX="/api/v1/uploads"
MAX_UPLOAD_BYTES="26214400"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="true"

# --- Not used by the MVP yet (phases 10-12) ---
LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="replace-me"
LIVEKIT_API_SECRET="replace-me"
CLOUDFLARE_TUNNEL_TOKEN="replace-me"

# Copy to .env and adjust. Never commit .env.

# --- Data stores (match docker-compose.dev.yml defaults) ---
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="betweenus"

# NOTE: The password inside DATABASE_URL MUST match POSTGRES_PASSWORD!
# - Host dev mode (pnpm dev): use localhost:5432 (e.g. postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/betweenus?schema=public)
# - Docker Compose: uses the 'postgres' container hostname inside the network.
# `127.0.0.1`, not `localhost`: the containers publish IPv4 only, and `localhost`
# resolves to `::1` first on Windows. Whether that address answers depends on a
# relay outside this repo - WSL's NAT networking provided one, mirrored
# networking does not - so a stack that worked yesterday starts answering
# "Can't reach database server at localhost:5432" for a reason that has nothing
# to do with the database. The literal address never had the ambiguity.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/betweenus?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

# --- One data path for the whole deployment ---
# Say where this deployment's data lives once, and let the tree be derived:
#
#   pnpm data:path /srv/sd2345/docker/betweenus
#
#     <root>/data/postgres    the database cluster
#     <root>/data/redis       Redis' own AOF/RDB
#     <root>/data/media       uploads: pictures/ and attachments/ below it
#     <root>/backup           pg_dump archives, gzipped plain SQL
#
# That creates the directories and writes the four paths below, because Compose
# cannot branch on whether a variable is set - it interpolates one variable per
# mount, and each defaults to a Docker named volume. Leave all five empty and
# the stack keeps its data in named volumes exactly as before.
#
# Not image/ and video/ under media: an attachment is encrypted in the renderer,
# so the server never learns what it is. Only pictures (avatars, server icons)
# are stored in the clear, which is why they get a directory of their own.
BETWEENUS_DATA_PATH=""
POSTGRES_DATA_PATH="postgres-data"
REDIS_DATA_PATH="redis-data"
BACKUP_DATA_PATH="backup-data"

# --- Pre-built images ---
# Read by infrastructure/docker/docker-compose.yml, which pulls the images the
# release workflow pushed. docker-compose.build.yml builds the same stack from
# this checkout instead and ignores both.
#
# `scripts/install.sh` writes this file, fetches that compose file and starts
# the stack without a clone at all - see docs/ for details.
#
# BETWEENUS_VERSION pins the release: "0.0.1" runs exactly that one, and a
# channel name - "alpha", "beta", "latest" - follows the newest of that channel
# on the next `docker compose pull`. Empty means "latest".
#
# Switching a running deployment between the two files changes nothing about
# the data: same project name, same volumes, same .env.
BETWEENUS_VERSION=""
BETWEENUS_IMAGE_REPO="aiyuayaan/betweenus"

# --- Database backups ---
# A `db-backup` container dumps the database on a schedule, and a one-shot dumps
# it once more immediately before every migration - the one moment a schema
# change can lose data for good.
# Hours between scheduled dumps. 168 = weekly; 24 = nightly; 1 = hourly.
BACKUP_INTERVAL_HOURS="168"
# How many dumps to keep. The oldest past this are deleted after each dump.
BACKUP_KEEP="8"
# 1 = dump before `prisma migrate deploy`, and refuse to migrate if that fails.
# 0 = migrate without one, which is a decision, not a default.
BACKUP_ON_MIGRATE="1"

# --- Auth ---
# Generate all secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# These two are checked at boot rather than trusted: the literal strings below
# are refused everywhere, the two must differ from each other, and in production
# each must be at least 32 characters. A service that was never given real
# secrets fails to start instead of signing sessions anyone could forge.
JWT_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="90d"
# How long a just-rotated refresh token still answers with the pair that
# rotation produced. Rotation is not atomic across a network: a reload or a
# dropped connection mid-refresh leaves the client holding a token the server
# has already spent, and without this window that is read as theft and signs
# every device out. A replay inside it creates no new session. 0 disables it.
REFRESH_REPLAY_GRACE_MS="30000"

# --- Admin panel and OAuth ---
# Public base URL a browser uses to reach the API. The OAuth callback URL shown
# in the admin panel is built from it, and it must match what is registered with
# Google/GitHub.
PUBLIC_API_URL="http://localhost:8080"
# Seals OAuth client secrets in the database. Falls back to JWT_SECRET when
# empty; changing either makes stored secrets unreadable (re-enter them).
SETTINGS_SECRET=""
# There is deliberately no OAUTH_ALLOWED_REDIRECTS. Where a finished sign-in
# may return to is derived from PUBLIC_API_URL and CORS_ORIGIN below - the
# deployment's own origins, which it has already had to name - plus loopback
# for the desktop client. Every deployment's answer was "my own site", and
# getting it wrong produced a BAD_REDIRECT on the one button nobody can test
# until the site is public.

# --- Forgotten passwords ---
# The SMTP server itself is not configured here: it is operator data, entered in
# the admin panel and stored sealed under SETTINGS_SECRET, exactly as the OAuth
# client secrets are. A deployment with nothing configured is a supported
# deployment - every client then says "ask your administrator" instead of
# offering to send mail, and an administrator opens a reset window per account
# from the panel.
#
# How long a reset link or an administrator-granted token stays usable. Short,
# because it is a bearer credential sitting in an inbox.
PASSWORD_RESET_TTL_MINUTES="30"
# How long an administrator's "this account may reset its password" grant stays
# open before it expires on its own.
PASSWORD_RESET_WINDOW_HOURS="24"
# What the username availability filter is sized for. Not a cap: exceeding it
# costs a slightly higher false-positive rate, which costs a database lookup
# that would have happened anyway.
USERNAME_BLOOM_CAPACITY="200000"

# --- Service ports (host dev mode) ---
AUTH_SERVICE_PORT="3001"
USER_SERVICE_PORT="3002"
SERVER_SERVICE_PORT="3003"
CHAT_SERVICE_PORT="3004"
PRESENCE_SERVICE_PORT="3005"
NOTIFICATION_SERVICE_PORT="3006"
CALL_SERVICE_PORT="3007"
REMOTE_GATEWAY_PORT="3008"

# --- Runtime ---
NODE_ENV="development"
LOG_LEVEL="debug"
CORS_ORIGIN="http://localhost:5173"

# --- Desktop client (Vite, must be VITE_ prefixed) ---
# The one address the desktop app needs, and now the only one. REST, every
# WebSocket and uploaded files are all behind this gateway, and media goes
# straight to the other participants rather than to a second address - so there
# is nothing else to point the client at.
#
# It only affects a packaged build. `pnpm dev` ignores it: the Vite dev server
# proxies to the services itself, so its own origin is the gateway and a value
# here would only point the app at an Nginx container development does not run.
#   VITE_API_URL="https://betweenus.example.com"
#
# It is only a default either way. The login screen can point a window at any
# other deployment, which is what "Connect to a self-hosted instance" does.
VITE_API_URL=""

# Listen Together's search box, in the web client only. Optional.
#
# The desktop app puts the real youtube.com in the panel. A browser tab cannot -
# youtube.com refuses to be framed, which is a rule the site sets - so the web
# client searches the YouTube Data API instead, from the person's own browser.
# Nothing on the server ever talks to YouTube, which is the rule section 4 of
# CLAUDE.md keeps for media and `shared-types` keeps for track titles.
#
# This is therefore a *browser* key and is visible to anybody using the site.
# That is what Google's HTTP-referrer restriction is for: create the key in the
# Cloud console with the YouTube Data API v3 enabled, and restrict it to the
# deployment's own hostname.
#
# Left empty, the web client keeps its paste box and says so. The desktop app
# never reads it.
VITE_YOUTUBE_API_KEY=""

# --- File storage ---
# Leave the S3 block empty for local development: uploads then go to
# LOCAL_STORAGE_PATH on disk and are served from /api/v1/uploads.
# Filling in all four S3 variables switches to the bucket automatically.
# STORAGE_DRIVER forces a driver ("local" or "s3"); leave unset for auto.
STORAGE_DRIVER=""
LOCAL_STORAGE_PATH="./storage-data"
LOCAL_STORAGE_PUBLIC_PREFIX="/api/v1/uploads"
# Docker only: where /data/uploads lives on the host. A bare name is a Docker
# volume; a path is a bind mount, so the files land where you can back them up.
# `pnpm data:path` writes this one too, as <root>/data/media.
#   UPLOAD_DATA_PATH="/mnt/disk2/betweenus-uploads"
UPLOAD_DATA_PATH="upload-data"
# Per request body: a single-shot upload, or one part of a large one. Nginx
# caps the same route at 32m, so raising this past that does nothing.
MAX_UPLOAD_BYTES="26214400"
# Per attachment, however many parts it took to get here.
MAX_ATTACHMENT_BYTES="104857600"
# Per avatar or server icon. The client downscales before it uploads.
MAX_PICTURE_BYTES="8388608"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="true"

# --- Push notifications (Firebase Cloud Messaging) ---
#
# Only Android needs these today: a desktop app that is running has the tray,
# and a phone with the app swiped away is the one client nothing else can
# reach. `notification-service` uses them to wake it; see docs/docs/architecture/notifications.md.
#
# The service account key is a private key. It is deliberately read from here
# and never from a file: a JSON key in the repository is one `git add .` away
# from a public one, and a container has an environment rather than a path.
# Turn a downloaded key into these three lines with:
#
#   pnpm firebase:env ./serviceAccountKey.json --write
#
# and then delete the file. Leave all of them empty and push is simply off -
# every other part of the service carries on.
#
# FIREBASE_PRIVATE_KEY keeps its newlines as literal 
, because a .env value
# is one line. The service undoes that on the way in.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# The same key as one variable, base64 or raw JSON, which is what a secrets
# manager tends to hand out. Set it and the three above are ignored.
#   pnpm firebase:env ./serviceAccountKey.json --single
FIREBASE_SERVICE_ACCOUNT=""

# --- Push notifications to browsers (Web Push / VAPID) ---
#
# The other half of push, and completely independent of the one above. Firebase
# reaches phones; this reaches a browser whose tab is closed. A deployment can
# have either, both, or neither, and none of those is broken - it only decides
# which kinds of client stay reachable when they are not running.
#
# No Firebase, no SDK, no account: VAPID is an ordinary P-256 key pair that
# identifies this deployment to whichever push service a browser uses. Mint one
# with:
#
#   npx web-push generate-vapid-keys
#
# The public half is handed to browsers - it is meant to be - and a
# subscription is bound to it, which is what stops anybody else pushing to that
# browser. The private half signs a JWT per send and is a secret like any other.
#
# Changing the pair invalidates every subscription already issued: those
# browsers re-subscribe on their next sign-in and are unreachable until then.
#
# VAPID_SUBJECT tells a push service who to complain to about this sender. A
# mailto is what the specification asks for and what the services accept.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# --- Calls, screen share and remote desktop ---
#
# There is no media-server address here, and there must never be one. Media goes
# directly between the participants; the backend only introduces them, over
# /ws/call and /ws/remote. See section 4 of claude.md for why an SFU and a
# Cloudflare Tunnel could never fit together.
#
# Where a peer asks what its own public address looks like from outside. It has
# to ask something: a machine behind NAT cannot describe itself, and a peer that
# cannot describe itself cannot be called.
#
# STUN is not a relay. No media passes through it, no port has to be opened for
# it, and one request per call is the whole of the traffic. The default is two
# public servers from different operators, because this is the one step of ICE
# with no fallback; point it at your own coturn if you would rather not talk to
# them. Comma-separated.
STUN_URLS="stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478"

# A relay, and the difference between "works for most people" and "works for
# everyone". Optional, and empty by default.
#
# Most pairs of networks find a direct path once they have asked STUN. Some
# cannot: symmetric NAT on both sides, and mobile carrier-grade NAT, where
# neither end can predict the address the other should send to. A TURN server is
# somewhere both ends reach outbound and forwards between them, so it opens no
# port here either - but it is a third party carrying the media, and it costs
# bandwidth, so it stays off unless you decide otherwise. Left empty, those
# particular calls fail rather than being quietly relayed, which is the intended
# default.
#
# Nothing about privacy changes if you turn one on. Media is DTLS-SRTP between
# the two peers, so a relay forwards packets it has no key for.
#
# A TURN server you run yourself - coturn, eturnal, or a relay from another
# provider. There is no API to mint against, so the credential is a long-term
# one you set here and rotate by changing it and restarting. Comma-separated,
# same as STUN_URLS. All three are needed together: a turn: URL with no
# credentials is refused by the relay and makes a client throw while building
# the peer connection, so a half-configured relay is logged and ignored rather
# than handed out.
#
# There used to be a second way - a hosted service whose short-lived
# credentials were minted here, checked first, with this as the fallback. It
# was removed after the hosted key was deleted at the provider: every mint
# answered 404, a failed mint meant "no relay" rather than "use the coturn in
# the same file", and every client got STUN-only while a working relay sat
# named three lines below. What is read from here cannot fail that way.
#
# THE RELAY NEEDS AN ADDRESS OF ITS OWN, AND THE TUNNEL CANNOT GIVE IT ONE.
# Both peers dial the relay outbound, so nothing is forwarded on the machine
# running BetweenUs - but the relay itself has to be reachable, which means a
# small VM with a public address rather than this host. A Cloudflare Tunnel
# carries HTTP and WebSocket: its edge terminates TLS on 443 and expects HTTP
# inside, and TURN over TLS is its own binary protocol, so a turns: URL aimed
# at the tunnel's hostname is refused before it reaches anything here.
# cloudflared's TCP ingress does not help either - that needs cloudflared or
# WARP running on the *client*, which a browser cannot do.
#
#   TURN_URLS="turns:turn.example.com:443?transport=tcp,turn:turn.example.com:3478"
#
# Both listeners are worth naming: UDP 3478 is the fast path, and TLS on 443
# is what gets through a network that drops everything but HTTPS.
TURN_URLS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# --- Public ingress (Cloudflare Tunnel) ---
# Where the gateway is published on the host. A cloudflared already running on
# this machine - one tunnel for the whole server - points its ingress at
# http://localhost:8080. Set it to "127.0.0.1:8080" to keep the gateway off the
# LAN while still reachable by a host tunnel.
GATEWAY_PORT="8080"
# Only needed to run cloudflared as a container:
#   docker compose -f infrastructure/docker/docker-compose.yml --profile public up -d
# Leave it empty when the tunnel already runs on the host.
CLOUDFLARE_TUNNEL_TOKEN=""


# --- Retention ---
# What the services delete on their own, and when. All of it is policy rather
# than fact, which is why it is here rather than in the code.
#
# Finished remote sessions say nothing the audit trail does not, so they go
# first; the audit trail is the point of the feature and is kept for a year. A
# session that has not ended is never swept, whatever its age - one with no
# `endedAt` is either running or was orphaned by a crash, and the second kind
# still has audit rows pointing at it.
REMOTE_SESSION_RETENTION_DAYS="30"
REMOTE_AUDIT_RETENTION_DAYS="365"
# Multipart uploads nobody finished. The parts of an upload in progress are
# touched every few seconds, so this only ever catches one that stopped;
# twelve hours means a laptop suspended mid-upload still finds its parts.
# Local storage driver only - a bucket does this with a lifecycle rule.
UPLOAD_SCRATCH_MAX_AGE_HOURS="12"
# How long an uploaded attachment nobody sent is kept. A file is uploaded
# before the message carrying it is sent, so an upload in progress looks
# exactly like an abandoned one; a day is far longer than that gap. A blob
# whose message has been deleted is collected at once, whatever this says.
ATTACHMENT_GRACE_HOURS="24"

# Copy to .env and adjust. Never commit .env.

# --- Data stores (match docker-compose.dev.yml defaults) ---
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="nexora"

# NOTE: The password inside DATABASE_URL MUST match POSTGRES_PASSWORD!
# - Host dev mode (pnpm dev): use localhost:5432 (e.g. postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/nexora?schema=public)
# - Docker Compose: uses the 'postgres' container hostname inside the network.
# `127.0.0.1`, not `localhost`: the containers publish IPv4 only, and `localhost`
# resolves to `::1` first on Windows. Whether that address answers depends on a
# relay outside this repo - WSL's NAT networking provided one, mirrored
# networking does not - so a stack that worked yesterday starts answering
# "Can't reach database server at localhost:5432" for a reason that has nothing
# to do with the database. The literal address never had the ambiguity.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/nexora?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

# --- Auth ---
# Generate all secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me"
JWT_REFRESH_SECRET="replace-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# How long a just-rotated refresh token still answers with the pair that
# rotation produced. Rotation is not atomic across a network: a reload or a
# dropped connection mid-refresh leaves the client holding a token the server
# has already spent, and without this window that is read as theft and signs
# every device out. A replay inside it creates no new session. 0 disables it.
REFRESH_REPLAY_GRACE_MS="30000"

# --- Admin panel and OAuth ---
# Public base URL a browser uses to reach the API. The OAuth callback URL shown
# in the admin panel is built from it, and it must match what is registered with
# Google/GitHub.
PUBLIC_API_URL="http://localhost:8080"
# Seals OAuth client secrets in the database. Falls back to JWT_SECRET when
# empty; changing either makes stored secrets unreadable (re-enter them).
SETTINGS_SECRET=""
# Extra origins a finished OAuth sign-in may be redirected back to, comma
# separated. Loopback (the desktop client) is always allowed.
OAUTH_ALLOWED_REDIRECTS="http://localhost:8080/admin"

# --- Service ports (host dev mode) ---
AUTH_SERVICE_PORT="3001"
USER_SERVICE_PORT="3002"
SERVER_SERVICE_PORT="3003"
CHAT_SERVICE_PORT="3004"
PRESENCE_SERVICE_PORT="3005"
NOTIFICATION_SERVICE_PORT="3006"
CALL_SERVICE_PORT="3007"
REMOTE_GATEWAY_PORT="3008"

# --- Runtime ---
NODE_ENV="development"
LOG_LEVEL="debug"
CORS_ORIGIN="http://localhost:5173"

# --- Desktop client (Vite, must be VITE_ prefixed) ---
# The one address the desktop app needs. REST, /ws/chat, /ws/presence and
# uploaded files are all behind this gateway, and the LiveKit address arrives
# inside a call token - so there is nothing else to point the client at.
#
# It only affects a packaged build. `pnpm dev` ignores it: the Vite dev server
# proxies to the services itself, so its own origin is the gateway and a value
# here would only point the app at an Nginx container development does not run.
#   VITE_API_URL="https://nexora.example.com"
#
# It is only a default either way. The login screen can point a window at any
# other deployment, which is what "Connect to a self-hosted instance" does.
VITE_API_URL=""

# --- File storage ---
# Leave the S3 block empty for local development: uploads then go to
# LOCAL_STORAGE_PATH on disk and are served from /api/v1/uploads.
# Filling in all four S3 variables switches to the bucket automatically.
# STORAGE_DRIVER forces a driver ("local" or "s3"); leave unset for auto.
STORAGE_DRIVER=""
LOCAL_STORAGE_PATH="./storage-data"
LOCAL_STORAGE_PUBLIC_PREFIX="/api/v1/uploads"
# Docker only: where /data/uploads lives on the host. A bare name is a Docker
# volume; a path is a bind mount, so the files land where you can back them up.
#   UPLOAD_DATA_PATH="/mnt/disk2/nexora-uploads"
UPLOAD_DATA_PATH="upload-data"
# Per request body: a single-shot upload, or one part of a large one. Nginx
# caps the same route at 32m, so raising this past that does nothing.
MAX_UPLOAD_BYTES="26214400"
# Per attachment, however many parts it took to get here.
MAX_ATTACHMENT_BYTES="104857600"
# Per avatar or server icon. The client downscales before it uploads.
MAX_PICTURE_BYTES="8388608"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="true"

# --- Voice channels (LiveKit) ---
# These defaults match infrastructure/livekit/livekit.yaml, which is a
# development-only key pair. Generate real ones for any deployment.
# What the client is told to dial. Two forms:
#   "/livekit"              - the path Nginx proxies to the SFU. Use this for a
#                             deployment: the client resolves it against the
#                             address it is already on, so the whole deployment
#                             is one hostname (and one Cloudflare Tunnel).
#   "ws://127.0.0.1:7880"   - an absolute address. Only ever right when the
#                             client and the SFU are the same machine: a
#                             packaged app pointed at a remote deployment would
#                             dial *its own* loopback and meet whatever SFU is
#                             listening there, whose keys are not this
#                             deployment's - which is what "token signature is
#                             invalid" means. `pnpm dev` proxies /livekit too,
#                             so "/livekit" is the right answer in both modes.
# Either way this is signalling. WebRTC media negotiates its own path to the SFU
# (7881/tcp and the 50000+ udp range), which no reverse proxy can stand in for.
LIVEKIT_URL="/livekit"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="nexora-dev-livekit-secret-change-me-please"

# The container stack only. The address the SFU puts in its ICE candidates, and
# therefore the address every client will try to send media to. There is no
# default because there is no answer that suits two deployments, and a wrong one
# is invisible until somebody tries to talk: signalling goes through the gateway
# and succeeds, then the call negotiates media to an address nobody can reach and
# the client gives up with "Connection to voice server timed out". Left unset,
# the SFU advertises its own Docker bridge address, which is that failure.
#
# It is the address clients reach this host on - a LAN address for a machine on
# a network, the public address for a server that has one - and 7881/tcp plus
# the 50000-50019 UDP range have to be reachable there. A Cloudflare tunnel does
# not carry them: it is an HTTP tunnel, and this is WebRTC.
LIVEKIT_NODE_IP="192.168.1.10"

# Calls from outside the SFU's own network, without opening a port.
#
# LIVEKIT_NODE_IP above is only reachable from where it is reachable. A
# self-hosted SFU behind a home router answers its own network and nothing else,
# and a Cloudflare tunnel does not help: that carries HTTP, and this is WebRTC.
# A TURN relay is somewhere both ends can meet, reached outbound from both, so
# nothing has to be forwarded or exposed.
#
# Create a TURN key at Cloudflare dashboard -> Realtime -> TURN. Both values
# below come from it, and both stay in call-service: what reaches a client is a
# short-lived credential minted per call, never the key. Leave them empty on a
# deployment whose clients are all on its own network - unset means clients use
# their own defaults, which is correct there.
#
# Call media is end-to-end encrypted with the channel key, which no server ever
# holds. A relay forwards packets it cannot read, exactly as the SFU already
# does.
CLOUDFLARE_TURN_KEY_ID=""
CLOUDFLARE_TURN_KEY_API_TOKEN=""
# How long a minted credential lives. It must outlast a call, or a long one
# loses its relay halfway through.
CLOUDFLARE_TURN_TTL_SECONDS="86400"

# Development only: the address the dev SFU puts in its ICE candidates, and
# whether its signalling and TCP-fallback ports are published beyond loopback.
# The default advertises 127.0.0.1, which is right for a browser on the same
# machine and unreachable from anywhere else.
#
# Joining a call from a *second machine* no longer needs either of these.
# `pnpm dev:web:lan` relays the SFU's media port from this host and has the page
# rewrite those loopback candidates to the address it was served from, which is
# a listener in an ordinary Windows process rather than a port opened into a WSL
# VM. They are still here for a host that would rather publish the SFU itself;
# set them, then recreate it with `pnpm dev:infra` - a container keeps the flags
# it was started with. See development/TESTING.md.
# NEXORA_LIVEKIT_NODE_IP="192.168.1.50"
# NEXORA_LIVEKIT_BIND="0.0.0.0"

# --- Public ingress (Cloudflare Tunnel) ---
# Where the gateway is published on the host. A cloudflared already running on
# this machine - one tunnel for the whole server - points its ingress at
# http://localhost:8080. Set it to "127.0.0.1:8080" to keep the gateway off the
# LAN while still reachable by a host tunnel.
GATEWAY_PORT="8080"
# Only needed to run cloudflared as a container:
#   docker compose -f infrastructure/docker/docker-compose.yml --profile public up -d
# Leave it empty when the tunnel already runs on the host.
CLOUDFLARE_TUNNEL_TOKEN=""


{
  "name": "nexora",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=./apps/services/*",
    "dev:gateway": "node scripts/dev-gateway.mjs",
    "dev:infra": "docker compose --env-file .env -f infrastructure/docker/docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose --env-file .env -f infrastructure/docker/docker-compose.dev.yml down",
    "dev:desktop": "pnpm --filter @nexora/desktop dev",
    "dev:web": "pnpm --filter @nexora/web dev",
    "dev:web:lan": "pnpm --filter @nexora/web dev --mode lan",
    "dev:admin": "pnpm --filter @nexora/admin dev",
    "dev:duo": "node scripts/dev-duo.mjs",
    "desktop:package": "pnpm --filter @nexora/desktop package",
    "desktop:package:portable": "pnpm --filter @nexora/desktop package:portable",
    "desktop:package:win": "pnpm --filter @nexora/desktop package:win",
    "desktop:package:win-packaged": "pnpm --filter @nexora/desktop package:win-packaged",
    "prod:build": "pnpm build",
    "prod:up": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml up -d --build",
    "prod:down": "docker compose --env-file .env -f infrastructure/docker/docker-compose.yml down",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "turbo run check",
    "db:generate": "pnpm --filter @nexora/database generate",
    "db:migrate": "pnpm --filter @nexora/database migrate",
    "db:seed": "pnpm --filter @nexora/database seed",
    "admin:create": "pnpm --filter @nexora/database admin:create",
    "db:studio": "pnpm --filter @nexora/database studio"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "turbo": "^2.0.0",
    "typescript": "^5.5.4"
  }
}

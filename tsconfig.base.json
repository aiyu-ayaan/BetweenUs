{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
    // No `paths` here. Every package builds with `rootDir: src` and resolves
    // its siblings through the workspace links, i.e. through their built
    // declarations. Mapping the names at the source instead pulls another
    // package's src/ into the program, and tsc refuses it:
    //   TS6059: File 'packages/shared-types/src/index.ts' is not under rootDir
    // which fails every service image build. The renderer is the exception and
    // carries its own mapping - see apps/desktop/tsconfig.json, which emits
    // nothing and needs the source because Vite bundles it.
  },
  "exclude": ["node_modules", "dist"]
}

{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "@nexora/shared-types": ["./packages/shared-types/src/index.ts"],
      "@nexora/permissions": ["./packages/permissions/src/index.ts"],
      "@nexora/auth": ["./packages/auth/src/index.ts"],
      "@nexora/config": ["./packages/config/src/index.ts"],
      "@nexora/database": ["./packages/database/src/index.ts"],
      "@nexora/events": ["./packages/events/src/index.ts"],
      "@nexora/logger": ["./packages/logger/src/index.ts"],
      "@nexora/nest-common": ["./packages/nest-common/src/index.ts"],
      "@nexora/storage": ["./packages/storage/src/index.ts"],
      "@nexora/websocket": ["./packages/websocket/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}

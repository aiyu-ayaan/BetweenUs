{
  "name": "@nexora/database",
  "private": true,
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "admin:create": "dotenv -e ../../.env -- tsx prisma/create-admin.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@nexora/config": "workspace:*",
    "@nexora/permissions": "workspace:*",
    "@nexora/shared-types": "workspace:*",
    "@prisma/client": "^5.18.0"
  },
  "devDependencies": {
    "@nexora/auth": "workspace:*",
    "@types/node": "^20.14.10",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.18.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}

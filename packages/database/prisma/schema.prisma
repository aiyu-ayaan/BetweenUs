// MVP schema. One schema shared by auth-, server- and chat-service; each
// service touches only the models it owns. Splitting per service is tracked in
// development/TODO.md (cross-cutting debt).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServerRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
  GUEST
}

enum ChannelType {
  TEXT
  VOICE
  /// A direct message between two people. It is a channel with no server, so
  /// history, paging, realtime fanout and encryption are the ones that already
  /// exist - see development/PLANNING.md (phase 12).
  DM
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

/// Platform-wide role, distinct from ServerRole: ADMIN grants the admin
/// panel, not membership rights inside any server.
enum GlobalRole {
  USER
  ADMIN
}

/// Who may see when this account was last here.
///
/// EVERYONE is the ceiling rather than the whole world: presence is already
/// scoped to the people who share a server or an accepted friendship with you,
/// so "everyone" means everyone who could already see your name. FRIENDS
/// narrows that to accepted friendships, and NOBODY switches the answer off.
///
/// NOBODY is reciprocal - see `User.lastSeenVisibility`.
enum LastSeenVisibility {
  EVERYONE
  FRIENDS
  NOBODY
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  username           String     @unique
  displayName        String
  passwordHash       String
  avatarUrl          String?
  /// The wide picture behind the name at the top of a profile.
  ///
  /// Separate from `avatarUrl` and not derivable from it: an avatar is cropped
  /// square and read at 32px in a member list, a cover is a 4:1 band read at
  /// several hundred. Scaling one into the other gives a blurred crop of
  /// somebody's face as a backdrop, which is why every app that has both
  /// stores both. Null means the client draws the accent colour it drew before
  /// this column existed.
  coverUrl           String?
  /// A line about yourself, shown on the profile card everywhere the app draws
  /// one. Not encrypted and not private: it is a caption on a name, the same
  /// way an avatar is, and every client that can see the name renders it.
  /// Capped at ABOUT_MAX_LENGTH (140) by the DTO, which is the length that
  /// still reads as one line under a heading.
  about              String     @default("Hey, I’m on Between Us.")
  /// The last moment presence-service saw this account connected and visible.
  ///
  /// Redis holds the live value while somebody is online (`presence:lastseen`);
  /// this column is what it is flushed to when the last window goes, so a
  /// person who has been away for a week still has an answer after a Redis
  /// wipe or a service restart. Never written while the account is invisible -
  /// a status that hid you but kept publishing when you were last here would
  /// not be hiding you.
  lastSeenAt         DateTime?
  /// Who may read `lastSeenAt`.
  ///
  /// **NOBODY is reciprocal**: an account that hides when it was last here does
  /// not get to read anybody else's either. That is WhatsApp's rule and it is
  /// the only thing that keeps the setting from being a one-way mirror - a
  /// feature everybody switches on the moment it costs them nothing.
  ///
  /// Enforced server-side in `presence-service`, never by the client hiding a
  /// value it was sent: a timestamp that reaches a client is a timestamp that
  /// account can read, whatever the UI does with it.
  lastSeenVisibility LastSeenVisibility @default(EVERYONE)
  role               GlobalRole @default(USER)
  /// Set for accounts created with a generated password (the bootstrap admin);
  /// they can do nothing until they choose their own.
  mustChangePassword Boolean    @default(false)
  /// A disabled account keeps its data but cannot log in or refresh.
  disabledAt         DateTime?
  /// While this is in the future the account is in administrator-granted reset
  /// mode: naming it on the forgot-password screen mints a single-use reset
  /// token instead of sending mail. It is how a deployment with no SMTP server
  /// still has a way back in - see `PasswordReset`.
  passwordResetUntil DateTime?
  /// Messages older than this are not returned to *this* account, in any
  /// channel, on any of its devices. Nobody else's copy is touched: the row is
  /// still there and the other side still reads it, which is the only honest
  /// thing a "clear my chats" button can mean in a two-party conversation.
  ///
  /// One column on the account rather than a marker per channel, because the
  /// feature asked for is "clear everything" and a per-channel column would be
  /// a fan-out write over every channel the account is in to answer it.
  chatsClearedAt     DateTime?
  /// This account's own disappearing-message window, in seconds, or null for
  /// "keep everything". Personal and one-sided: it hides messages older than
  /// the window from *this* account on every one of its devices, and touches
  /// nobody else's copy. A server's own window (`Server.messageTtlSeconds`)
  /// outranks it - that one actually deletes rows, for everyone.
  messageTtlSeconds  Int?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  refreshTokens   RefreshToken[]
  ownedServers    Server[]             @relation("ServerOwner")
  memberships     ServerMember[]
  channelSeats    ChannelMember[]
  friendshipsA    Friendship[]         @relation("FriendshipA")
  friendshipsB    Friendship[]         @relation("FriendshipB")
  messages        Message[]
  deletedMessages Message[]            @relation("MessageDeletedBy")
  pinnedMessages  Message[]            @relation("MessagePinnedBy")
  reactions       MessageReaction[]
  /// One per machine this account has signed in on - see DeviceKey.
  deviceKeys      DeviceKey[]
  /// One per installation that can be pushed to - see DeviceToken.
  deviceTokens    DeviceToken[]
  identityBackups IdentityBackup[]
  identities      UserIdentity[]
  notifications   NotificationSetting?
  channelReads    ChannelRead[]
  serverInvites   ServerInvite[]       @relation("ServerInviteCreatedBy")
  remoteMachines  RemoteMachine[]      @relation("RemoteMachineOwner")
  remoteGrants    RemoteGrant[]        @relation("RemoteGrantUser")
  remoteGranted   RemoteGrant[]        @relation("RemoteGrantGrantedBy")
  remoteSessions  RemoteSession[]      @relation("RemoteSessionUser")
  remoteAudit     RemoteAudit[]        @relation("RemoteAuditActor")
  adminAudit      AdminAudit[]         @relation("AdminAuditActor")
  attachments     Attachment[]         @relation("AttachmentUploader")
  messageViews    MessageView[]
  callSessions    CallSession[]        @relation("CallSessionUser")
  passwordResets  PasswordReset[]
  /// People this account has blocked, and the blocks pointed back at it.
  blocksMade      UserBlock[]          @relation("BlockAuthor")
  blocksAgainst   UserBlock[]          @relation("BlockTarget")
  /// Webhooks this account opened. See Webhook.
  webhooks        Webhook[]            @relation("WebhookCreatedBy")
  /// Statuses this account has posted, and the ones it has opened. See Status.
  statuses        Status[]             @relation("StatusAuthor")
  statusViews     StatusView[]         @relation("StatusViewer")

  @@map("users")
}

/// One account refusing another.
///
/// Directional, unlike `Friendship`, which stores an ordered pair: a block is
/// something one person does and the other is not told about, so "A blocked B"
/// and "B blocked A" are two different facts and either one on its own has to
/// close the conversation. The gate reads both directions - see
/// `isBlockedBetween` in `@betweenus/database`.
model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockAuthor", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  // "Who has blocked me" is asked as often as "who have I blocked": the first is
  // what closes a channel for the other side.
  @@index([blockedId])
  @@map("user_blocks")
}

/// A single-use permission to set a password without knowing the old one.
///
/// Only the SHA-256 of the token is stored, for the same reason `RefreshToken`
/// stores a hash: a leaked database must not be a pile of live reset links.
/// `source` records which of the two doors it came through - a link mailed by
/// the SMTP server, or an administrator putting the account into reset mode -
/// because those are worth telling apart afterwards.
model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  /// SHA-256 of the token handed to the client. Never logged.
  tokenHash String    @unique
  /// email | admin
  source    String
  expiresAt DateTime
  /// Set the moment it is spent; a spent token is kept as the record that it was.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

/// The deployment's outgoing mail server, configured from the admin panel.
///
/// One row, like `OAuthProvider` is one row per provider: this is operator
/// configuration and not user data. No row - or a row with `enabled` false -
/// is a deployment that cannot send mail at all, and every screen that would
/// have offered to mail something says "ask your administrator" instead.
model SmtpSetting {
  id          String  @id @default("smtp")
  enabled     Boolean @default(false)
  host        String  @default("")
  port        Int     @default(587)
  /// True for implicit TLS on connect (port 465); false starts plain and
  /// upgrades with STARTTLS, which is what 587 wants.
  secure      Boolean @default(false)
  username    String  @default("")
  /// Sealed with AES-256-GCM under SETTINGS_SECRET, exactly as
  /// `OAuthProvider.clientSecret` is. It never leaves the server in either
  /// direction - the panel can replace it but never read it back.
  password    String  @default("")
  /// The envelope sender. Providers reject mail whose From they do not own.
  fromAddress String  @default("")
  fromName    String  @default("BetweenUs")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("smtp_settings")
}

/// Append-only record of what an administrator did in the admin panel.
///
/// The subject of an admin action is very often an account that no longer
/// exists - deleting somebody is the action most worth having a record of - so
/// the target is stored as a label as well as an id. The id goes null with the
/// account; the label is what the log still reads back afterwards.
model AdminAudit {
  id          String  @id @default(uuid())
  /// Null once the administrator's own account is deleted. The row outlives it.
  actorId     String?
  /// Who or what it was done to: a user id, or a provider name for OAuth.
  targetId    String?
  /// How the target read at the time - `@ayaan`, `google`. Never updated.
  targetLabel String?
  /// user.role.changed, user.disabled, user.enabled, user.deleted,
  /// oauth.updated.
  action      String
  detail      Json?

  createdAt DateTime @default(now())

  actor User? @relation("AdminAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("admin_audit")
}

/// Per-account notification settings, owned by notification-service. One row
/// per user, written the first time anything is changed - an account with no
/// row is an account with the defaults.
model NotificationSetting {
  userId                String   @id
  /// Off entirely; the client raises nothing while this is false.
  enabled               Boolean  @default(true)
  /// Quiet hours as minutes from midnight on the client's own clock, so the
  /// server never has to know a timezone. Null on either end means no quiet
  /// hours. A window is allowed to wrap midnight (start 1320, end 480).
  quietStartMinute      Int?
  quietEndMinute        Int?
  /// Channels this account never wants raised.
  /// ponytail: an array column, not a join table - the list is small and is
  /// only ever read whole. Split it out when a mute grows its own settings.
  mutedChannelIds       String[] @default([])
  /// Channels that only raise a notification when this account is mentioned -
  /// the middle setting between everything and nothing, and the one a busy
  /// server actually needs. A channel in both lists is silent: the stronger
  /// setting wins, so a mute is never weakened by another list.
  ///
  /// Whether a message mentions somebody is decided on the client, because the
  /// server cannot read it: bodies are sealed with the channel key and this
  /// service stores a preference, not a message.
  mentionOnlyChannelIds String[] @default([])
  /// People this account never wants raised, wherever they write.
  ///
  /// A channel mute is the wrong tool for one loud person in five channels, and
  /// leaving is the wrong tool for a colleague. Same shape and same reasoning
  /// as the two lists above: small, read whole, and applied on the client -
  /// which is the only side that knows who wrote a sealed message, since the
  /// author is on the envelope but the decision to raise anything is not.
  mutedUserIds          String[] @default([])
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

/// How far a user has read a channel. Unread counts are derived from it rather
/// than stored, so they survive a restart and follow the account to another
/// machine instead of living in one client's memory.
model ChannelRead {
  userId     String
  channelId  String
  lastReadAt DateTime  @default(now())
  /// Messages older than this are not returned to this user *in this channel*.
  /// The per-conversation half of `User.chatsClearedAt`, and it lives here
  /// rather than in a table of its own because this row is already the one
  /// thing keyed on exactly (user, channel) - a second table would be the same
  /// key, the same cascade and the same lookup, twice.
  ///
  /// The two are read together: the floor is whichever is later.
  clearedAt  DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@index([channelId])
  @@map("channel_reads")
}

/// One installation's push token, owned by notification-service.
///
/// Keyed on (user, device) and not on the token. A registration token rotates -
/// FCM mints a new one after a restore, a clear-data, or on its own schedule -
/// so a registry keyed on the token grows a row per rotation and then pushes to
/// every dead one. `deviceId` is the same client-minted installation id
/// `DeviceKey` uses, which makes one phone one row for as long as the app is
/// installed.
///
/// The token is also unique on its own, because the *device* can move between
/// accounts: signing out and into another account on the same phone gives that
/// account the same token, and the row it used to belong to has to go rather
/// than keep pushing somebody else's messages at it.
model DeviceToken {
  id         String   @id @default(uuid())
  userId     String
  /// Client-minted, stable per installation.
  deviceId   String
  /// The FCM registration token. Never logged - see section 23 of CLAUDE.md.
  token      String   @unique
  /// android | ios | web. A string rather than an enum: adding a transport
  /// should not be a migration.
  platform   String
  /// What to call it in a list: "Pixel 8". Client-supplied and untrusted.
  label      String?
  /// The client build, so a push a version cannot render can be skipped.
  appVersion String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("device_tokens")
}

/// A third-party login linked to an account. The provider's own user id is what
/// identifies the person on the next login; email can change on their side.
model UserIdentity {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("user_identities")
}

/// OAuth provider credentials, configured from the admin panel rather than the
/// environment, so enabling a login is an operator action and not a redeploy.
/// `clientSecret` is stored sealed - see packages/auth `sealSecret`.
model OAuthProvider {
  provider     String   @id
  enabled      Boolean  @default(false)
  clientId     String
  clientSecret String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("oauth_providers")
}

/// One machine's end-to-end encryption identity key (ECDH P-256, JWK, public
/// half only). The private half never leaves that machine in the clear.
///
/// A list per user rather than one row per user, which is the difference
/// between "this account has a key" and "this laptop has a key". It buys two
/// things the single row could not: a device can be revoked on its own, without
/// rotating an identity every other machine is also using, and a channel key is
/// wrapped for the devices that should have it rather than for an identity that
/// has been copied to who-knows-where.
///
/// `deviceId` is minted by the client and is stable for an installation. A
/// revoked row is kept rather than deleted: the wraps addressed to it go, but
/// the record of what was trusted and when it stopped being trusted is the only
/// thing anybody can audit afterwards.
model DeviceKey {
  id         String    @id @default(uuid())
  userId     String
  /// Client-minted, stable per installation.
  deviceId   String
  publicKey  String
  /// What to call it in a list: "Ada's laptop", "Pixel 8". Client-supplied.
  label      String?
  /// Set when the owner revoked it. Nothing is wrapped for a revoked device.
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("device_keys")
}

/// The identity private key, sealed on the client with a key derived from a
/// secret the server never receives (PBKDF2 over the account password, or over
/// a passphrase the user set). Without it, wiping an installation - or signing
/// in on a second machine - meant a new identity and a history nobody could
/// open. The server stores the blob and hands it back to its owner; it holds
/// nothing that opens it.
model IdentityBackup {
  id         String   @id @default(uuid())
  userId     String
  version    Int      @default(1)
  /// "password" or "passphrase": what the client must ask the user for.
  kind       String
  kdf        String
  iterations Int
  salt       String
  iv         String
  ciphertext String
  /// Public half of the sealed pair, so a client can recognise a stale backup.
  publicKey  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One backup per secret kind, not one per account. A recovery passphrase
  /// used to replace the password-sealed blob, which quietly took away the
  /// only thing a fresh sign-in can open on its own - see development/devdocs/E2EE.md.
  @@unique([userId, kind])
  @@index([userId])
  @@map("identity_backups")
}

/// A channel's symmetric content key, wrapped once per recipient. The server
/// stores only ciphertext it cannot open: `wrappedKey` is sealed with the ECDH
/// secret between `senderPublicKey` and the recipient's device key.
model ChannelKey {
  id                String   @id @default(uuid())
  channelId         String
  epoch             Int
  recipientUserId   String
  /// Which of that user's devices this copy is sealed for. One row per device,
  /// because a wrap is to a key and a key belongs to a machine.
  recipientDeviceId String
  senderUserId      String
  /// Which machine did the sealing, so a wrap can be attributed after the fact.
  senderDeviceId    String
  senderPublicKey   String
  wrappedKey        String
  iv                String
  createdAt         DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, epoch, recipientUserId, recipientDeviceId])
  @@index([channelId, recipientUserId])
  @@map("channel_keys")
}

model RefreshToken {
  // `id` is the JWT `jti`, so revoking a token is a delete by id.
  id        String    @id
  userId    String
  // The sign-in this token descends from: the `id` of the token that sign-in
  // minted, carried forward by every rotation of it. One device is one family,
  // so a token replayed on a phone cannot sign the same account out of a
  // laptop - which is what revoking by `userId` did.
  familyId  String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Server {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  iconUrl   String?
  ownerId   String
  /// How long a message sent in this server's channels lives, in seconds, or
  /// null for "for ever". Set by whoever holds MANAGE_SERVER, and it binds
  /// every member: the sweeper destroys the row and its blobs when the window
  /// closes, so this is a deletion and not a filter.
  ///
  /// Stamped onto each message as it is sent rather than evaluated at read
  /// time, so changing the window governs what is sent next and never
  /// retroactively resurrects or condemns what is already there.
  messageTtlSeconds Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User               @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  ServerMember[]
  channels Channel[]
  invites  ServerInvite[]
  roles    ServerCustomRole[]
  emoji    ServerEmoji[]

  @@index([ownerId])
  @@map("servers")
}

/// A role a server invented for itself: a name, a colour, a place in the list,
/// and a bundle of permissions.
///
/// It does not replace `ServerRole`. The five built-ins are the hierarchy - who
/// may edit whom, who may hand out what - and that stays a ladder with a fixed
/// number of rungs, because a hierarchy anyone can extend is a hierarchy anyone
/// can climb. A custom role is additive: it grants permissions on top, and a
/// member's denials still win over it, so taking a capability away from one
/// person never depends on which roles they happen to hold.
model ServerCustomRole {
  id          String   @id @default(uuid())
  serverId    String
  name        String
  /// `#rrggbb`, or null for a role that takes the default colour. A member
  /// shows the colour of the highest-ranked role they hold that has one.
  colour      String?
  /// Higher is further up the list. Display order, and the tie-break for whose
  /// colour a member wears; it grants nothing by itself.
  rank        Int      @default(0)
  /// Names from the assignable set. Unknown strings are ignored when resolving,
  /// so a role written by a newer build cannot break an older one.
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  server  Server             @relation(fields: [serverId], references: [id], onDelete: Cascade)
  members ServerMemberRole[]

  /// Two roles with the same name in one server are a support ticket.
  @@unique([serverId, name])
  @@index([serverId, rank])
  @@map("server_custom_roles")
}

/// One member holding one custom role. A member may hold any number.
model ServerMemberRole {
  memberId   String
  roleId     String
  assignedAt DateTime @default(now())

  member ServerMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   ServerCustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@index([roleId])
  @@map("server_member_roles")
}

/// A way in that can be taken away again.
///
/// The slug was the only way to join, and a slug is permanent, public and
/// guessable from the server's name: handing it to one person handed it to
/// everyone they ever forward it to, forever. An invite is a code with an
/// optional expiry and an optional cap on how many times it may be used, and
/// revoking it is a column rather than renaming the server.
model ServerInvite {
  id          String    @id @default(uuid())
  /// Random and unguessable, not derived from the server's name.
  code        String    @unique
  serverId    String
  /// Null once the account that made it is deleted; the invite is the server's,
  /// not theirs, so it outlives them.
  createdById String?
  /// Null for an invite that does not expire, which is a deliberate choice
  /// somebody has to make rather than the only behaviour available.
  expiresAt   DateTime?
  /// Null for unlimited. Counted rather than decremented so a spent invite
  /// still says how popular it was.
  maxUses     Int?
  uses        Int       @default(0)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  server    Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("ServerInviteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([serverId])
  @@map("server_invites")
}

model ServerMember {
  id                 String     @id @default(uuid())
  serverId           String
  userId             String
  role               ServerRole @default(MEMBER)
  /// Permissions this member holds beyond the role's defaults, so an
  /// administrator can hand one person one capability without inventing a role.
  grantedPermissions String[]   @default([])
  /// Permissions withheld even though the role would grant them. Deny wins.
  deniedPermissions  String[]   @default([])
  /// Whether this member was let in *with* what was said before they arrived.
  ///
  /// A newcomer normally reads from the moment they join and no further back:
  /// they hold no earlier epoch, nobody may hand them one, and every message
  /// before that stays a padlock. That is the right default and it stays the
  /// default. But it is a decision somebody should be able to make, and the
  /// server cannot make it - it holds no key - so this is the flag the clients
  /// act on: with it set, the key directory offers this member's devices every
  /// epoch of every channel in the server rather than only the ones they
  /// already hold somewhere, and the first member's machine to open the channel
  /// seals them. See `gaps()` in chat-service's e2ee service.
  ///
  /// It is not retroactive in the other direction: clearing it takes nothing
  /// back, because a key that has been sealed for a device has been sealed.
  historyShared      Boolean    @default(false)
  joinedAt           DateTime   @default(now())

  server Server             @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles  ServerMemberRole[]

  @@unique([serverId, userId])
  @@index([userId])
  @@map("server_members")
}

model Channel {
  id        String      @id @default(uuid())
  /// Null for a direct message, which belongs to its two participants rather
  /// than to a server.
  serverId  String?
  name      String
  type      ChannelType @default(TEXT)
  topic     String?
  /// A private channel is visible only to the users listed in `members`. Server
  /// membership grants nothing here - not even to an administrator, who has to
  /// be added like anyone else. See development/PLANNING.md (phase 12).
  isPrivate Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  server   Server?         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  members  ChannelMember[]
  messages Message[]
  keys     ChannelKey[]
  reads    ChannelRead[]
  webhooks Webhook[]

  @@unique([serverId, name])
  @@map("channels")
}

/// A URL an outside system can POST to in order to say something in a channel.
///
/// Discord's shape, because it is the one every CI runner, alerting stack and
/// "send to chat" integration already speaks: one opaque URL carrying its own
/// authority, a JSON body with a `content` field, and no account, OAuth flow
/// or bot framework anywhere near it. A webhook that needed its own client
/// library would not be reachable from the `curl` in somebody's deploy script,
/// which is the entire point of having one.
///
/// **This is the one place a message body is stored in the clear, and it is a
/// deliberate, visible exception rather than a hole.** The sealed-envelope
/// design assumes every author holds the channel key; a build server does not,
/// cannot be given one (handing a channel key to a script is handing away the
/// channel), and could not use one without shipping this project's crypto to
/// every language anybody writes a deploy script in. So the trade is made
/// explicitly and shown to people rather than hidden: `Message.kind` is
/// `WEBHOOK`, and every client draws the row with a badge saying it was not
/// encrypted. A channel with a webhook on it is a channel whose E2EE guarantee
/// is now "everything except what the robots say", and the clients say exactly
/// that instead of implying more.
///
/// The token is stored as a SHA-256 hash and shown once, at creation - the same
/// rule as `RemoteMachine.agentTokenHash` and `PasswordReset.tokenHash`.
/// Discord shows its webhook URLs again on demand, which requires keeping them
/// reversible; a token that can be re-read out of a database is a token a
/// database dump hands over. Losing it is recoverable by rotating it, which is
/// what the endpoint exists for.
model Webhook {
  id          String    @id @default(uuid())
  channelId   String
  /// SHA-256 of the token half of the URL. Unique, so a delivery is one indexed
  /// lookup rather than a scan of every webhook on the deployment.
  tokenHash   String    @unique
  /// What the messages are signed with. Not a username and not unique: it is a
  /// label on a robot, and two servers may both have one called "deploys".
  name        String
  /// An uploaded picture, or null for the initial drawn from `name`.
  avatarUrl   String?
  /// Who made it. Kept for the audit trail and for `Message.authorId`, which is
  /// not nullable - a webhook row is attributed to the person who opened the
  /// door, and the clients draw the webhook's name over the top.
  createdById String
  /// Null until something has actually posted through it. The first thing
  /// anybody wants to know about a webhook that "isn't working".
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  channel   Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdBy User      @relation("WebhookCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([channelId])
  @@map("webhooks")
}

/// One row per user allowed into a private channel. Rows on a public channel
/// are ignored, so making a channel private later needs no backfill.
model ChannelMember {
  id        String   @id @default(uuid())
  channelId String
  userId    String
  addedAt   DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@map("channel_members")
}

/// One row per relationship, not one per direction: a request and a friendship
/// are the same thing in two states. The pair is stored with the lower user id
/// first so the unique constraint catches two people requesting each other.
model Friendship {
  id          String           @id @default(uuid())
  userAId     String
  userBId     String
  /// Who sent the request. Only the other side may accept it.
  requesterId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userA User @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("friendships")
}

/// A server's own emoji: a picture and a name people type between colons.
///
/// The picture is an ordinary upload under `pictures/`, which is the one thing
/// this deployment serves without authentication - it has to be, because an
/// `<img>` tag cannot carry a header, and an emoji is drawn a hundred times a
/// screen. So an emoji is public by construction, and nothing about it is
/// secret: the name and the image are exactly what everybody in the server is
/// meant to see.
///
/// What is *not* here is any link to a message. A message body is sealed, so
/// which emoji a message uses is not a question this table could answer even
/// if it wanted to - the client carries the manifest inside the envelope.
model ServerEmoji {
  id          String   @id @default(uuid())
  serverId    String
  /// Lowercase letters, digits and underscores - what fits between two colons.
  name        String
  /// Storage URL of the picture, rooted at `/api/v1/uploads/pictures/...`.
  url         String
  /// True for a GIF or an animated WebP. Stored rather than sniffed so a client
  /// can decide whether to draw it still until it is hovered.
  animated    Boolean  @default(false)
  /// Null once the uploader's account is gone; the emoji outlives them.
  createdById String?
  createdAt   DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, name])
  @@index([serverId])
  @@map("server_emoji")
}

/// What a row in a conversation *is*.
///
/// `USER` is a message somebody wrote, and its body is ciphertext nothing here
/// can read. `MEMBER_JOIN` is the conversation noting that somebody arrived -
/// written by the server, addressed to nobody, and carrying no body at all.
///
/// The two are separated by a column rather than by a marker inside the body
/// for the obvious reason: the server writes the second kind and cannot write
/// the first, because it holds no key. A client reads the kind and draws the
/// line itself, which is also why nothing about the phrasing is stored.
enum MessageKind {
  USER
  MEMBER_JOIN
  /// Posted by an outside system through a `Webhook`. Unlike `USER`, `content`
  /// is **plaintext**: the sender holds no channel key and cannot seal it. See
  /// the `Webhook` model for why that is a deliberate, visible exception.
  WEBHOOK
}

model Message {
  id          String    @id @default(uuid())
  channelId   String
  authorId    String
  /// Which sort of row this is; see [MessageKind]. `USER` unless the server
  /// wrote it, which keeps every row that existed before this column correct.
  kind        MessageKind @default(USER)
  // Opaque to the server: clients store a serialised `EncryptedEnvelope` here.
  /// Empty for every kind but `USER`: there is nothing to say that the kind and
  /// the author do not already say, and an empty string is honest about that in
  /// a way a server-written sentence in one language would not be.
  content     String
  createdAt   DateTime  @default(now())
  editedAt    DateTime?
  deletedAt   DateTime?
  /// Who deleted it, when that was not the author - a client shows "deleted by
  /// NAME" rather than pretending the author took it back.
  deletedById String?
  pinnedAt    DateTime?
  pinnedById  String?
  /// When this message stops existing, stamped from the server's disappearing
  /// window at send time. Null means it stays until somebody deletes it. The
  /// disappearing sweeper destroys the row outright rather than tombstoning
  /// it: a tombstone that says "a message was here" for ever is not what a
  /// disappearing message was asked to be.
  expiresAt   DateTime?
  /// A one-time message: each recipient may open its media once, and it is
  /// destroyed once every one of them has.
  ///
  /// The flag is outside the encrypted body because the server has to act on
  /// it - burning is a row update and a blob delete, and a server that cannot
  /// read the body cannot be told by the body. What leaks is that some message
  /// was one-time, which is a fact both clients already draw on screen.
  viewOnce    Boolean           @default(false)
  /// When the *first* recipient opened it. Not the gate - `views` is - but the
  /// stamp a backstop expiry is measured from, so a one-time message nobody
  /// finishes opening still leaves eventually.
  viewedAt    DateTime?
  /// Which webhook posted this, when one did. Set exactly when `kind` is
  /// `WEBHOOK`, and what a client reads the name and picture off - `author` is
  /// the account that created the webhook, which is not who the row is from.
  webhookId   String?

  channel     Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  deletedBy   User?             @relation("MessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  pinnedBy    User?             @relation("MessagePinnedBy", fields: [pinnedById], references: [id], onDelete: SetNull)
  /// `SetNull` rather than `Cascade`: deleting a webhook must not delete what
  /// it has already said. The rows stay and fall back to the name frozen into
  /// their own body.
  webhook     Webhook?          @relation(fields: [webhookId], references: [id], onDelete: SetNull)
  reactions   MessageReaction[]
  attachments Attachment[]
  views       MessageView[]

  // History paging reads newest-first within a channel.
  @@index([channelId, createdAt])
  // The pinned panel lists one channel's pins, newest pin first.
  @@index([channelId, pinnedAt])
  // The disappearing sweeper reads whatever is past its window, oldest first.
  @@index([expiresAt])
  @@map("messages")
}

/// One person's one look at a one-time message.
///
/// A row per viewer rather than a single `viewedAt` on the message, because a
/// one-time message has as many looks in it as there are people who can see
/// it. The single stamp meant the first person to open one in a channel
/// destroyed it for everybody else, who then saw "Opened" for something they
/// had never been shown - which is not one look each, it is one look in total
/// and a race to it.
///
/// The message is destroyed when this table covers everyone who could see it,
/// minus the author - who is not a viewer, because re-reading what you sent
/// spends nobody's look.
model MessageView {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  viewedAt  DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("message_views")
}

/// One person's one emoji on one message.
///
/// The emoji is stored in the clear, unlike everything else about a message.
/// That is a deliberate, documented leak (see development/E2EE.md): the server
/// has to group and count reactions for people who hold no channel key at the
/// moment they ask, and an encrypted-per-recipient reaction would cost a key
/// exchange per thumbs-up.
model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

/// One uploaded blob, and which message claims it.
///
/// This row exists for one reason: nothing else can say which object belongs to
/// which message. The manifest naming a message's files is *inside* the
/// encrypted body, so no service can read it, and without a row here a deleted
/// message left its ciphertext in storage for ever. The alternative - the
/// deleting client removing what it can read - leaves behind everything a
/// moderator deletes, which is exactly the case that matters.
///
/// What this costs is one small piece of metadata: the server learns that some
/// number of blobs, of some size, belong to one message. It already knew the
/// blobs and their sizes; the name, the type and the contents stay sealed.
///
/// Neither foreign key cascades, deliberately. A row destroyed by somebody
/// else's cascade is a blob nothing will ever name again, so both go null
/// instead and the sweeper - which looks for rows no message claims - collects
/// the object. That makes one mechanism cover a deleted message, a deleted
/// channel, a deleted server, a deleted account and an upload nobody ever sent.
model Attachment {
  id         String   @id @default(uuid())
  /// The storage key. Unique: one row per object, so claiming twice is caught.
  key        String   @unique
  /// Null once the account that uploaded it is gone. See the note above.
  uploaderId String?
  /// Ciphertext length, which is not the plaintext size and is not meant to be.
  size       Int
  /// Null until the message carrying it is sent, and null again if that message
  /// row is destroyed rather than tombstoned.
  messageId  String?
  createdAt  DateTime @default(now())

  uploader User?    @relation("AttachmentUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([messageId])
  /// The sweeper reads unclaimed rows oldest first.
  @@index([createdAt])
  @@map("attachments")
}

// --- Remote desktop (phase 17) ------------------------------------------------
//
// Kept apart from chat and media on purpose: a remote session is the most
// dangerous thing this platform can do, so it has its own service, its own
// permission set that no role grants by default, and its own audit trail.

/// A machine that has enrolled an agent. The agent connects outbound to
/// remote-gateway; nothing ever dials the machine, and no inbound port is
/// opened on it.
model RemoteMachine {
  id       String @id @default(uuid())
  /// Whoever enrolled it. The owner always has every remote permission on it
  /// and is the only one who may hand them out.
  ownerId  String
  name     String
  platform String

  /// The agent's credential, stored as a SHA-256 hash the way a password is.
  /// It is shown once, at enrolment, and rotated by enrolling again.
  ///
  /// ponytail: a shared secret, not a device keypair. It is what cloudflared
  /// and every other outbound agent uses; a signed handshake is the upgrade if
  /// a stolen token at rest ever becomes the threat that matters.
  ///
  /// Unique, and indexed by being so: an agent connecting is one lookup rather
  /// than a scan of every machine's hash.
  agentTokenHash String    @unique
  /// Null until the agent has connected once.
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner    User            @relation("RemoteMachineOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  grants   RemoteGrant[]
  sessions RemoteSession[]
  audit    RemoteAudit[]

  @@index([ownerId])
  @@map("remote_machines")
}

/// What one person may do to one machine. Absent means no access at all -
/// remote permissions are never implied by a server role.
model RemoteGrant {
  id          String    @id @default(uuid())
  machineId   String
  userId      String
  /// REMOTE_VIEW, REMOTE_CONTROL, REMOTE_FILE_TRANSFER, REMOTE_CLIPBOARD,
  /// REMOTE_AUDIO, REMOTE_ADMIN. Unknown strings are ignored when resolving,
  /// so a row written by a newer build cannot break an older one.
  permissions String[]  @default([])
  /// Temporary access: past this moment the grant resolves to nothing. Null is
  /// open-ended.
  expiresAt   DateTime?
  grantedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  machine   RemoteMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  user      User          @relation("RemoteGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?         @relation("RemoteGrantGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([machineId, userId])
  @@index([userId])
  @@map("remote_grants")
}

/// One connection from one person to one machine. The permissions are frozen
/// when it starts, so revoking a grant mid-session is a decision the gateway
/// takes deliberately (it ends the session) rather than an accident of timing.
model RemoteSession {
  id          String    @id @default(uuid())
  machineId   String
  userId      String
  permissions String[]  @default([])
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  /// Why it stopped: "controller", "agent", "revoked", "agent-offline".
  endedReason String?

  machine RemoteMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  user    User          @relation("RemoteSessionUser", fields: [userId], references: [id], onDelete: Cascade)
  audit   RemoteAudit[]

  @@index([machineId, startedAt])
  @@index([userId, startedAt])
  @@map("remote_sessions")
}

/// Append-only record of everything that happened to a machine. Nothing here is
/// ever updated or deleted by the application; a machine's owner can read it.
model RemoteAudit {
  id        String  @id @default(uuid())
  machineId String
  sessionId String?
  /// Who did it. Null when it was the agent itself rather than a person.
  actorId   String?
  /// machine.enrolled, machine.renamed, permission.changed, session.started,
  /// session.ended, session.refused.
  action    String
  detail    Json?

  createdAt DateTime @default(now())

  machine RemoteMachine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  session RemoteSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  actor   User?          @relation("RemoteAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([machineId, createdAt])
  @@map("remote_audit")
}

/// One person's stay in one call: how long they were in it, who else was there
/// while they were, and how much data their machine moved doing it.
///
/// Written by `call-service`, which holds the sockets and is therefore the only
/// thing that knows when somebody actually arrived and left - a client's own
/// account of that is a client that can write itself an hour-long call it never
/// joined.
///
/// The names are snapshots rather than joins on purpose. A call log is history,
/// and a channel that was deleted or a server that was left is exactly the
/// entry somebody is trying to remember; a foreign key would take those rows
/// away at the moment they became interesting.
model CallSession {
  id            String    @id @default(uuid())
  userId        String
  channelId     String
  channelName   String
  /// Null for a direct message, which belongs to no server.
  serverId      String?
  serverName    String?
  joinedAt      DateTime  @default(now())
  /// Null while the call is still up, and for a row whose process died mid-call.
  endedAt       DateTime?
  /// Everybody else who was in the call at any point while this person was, by
  /// user id. Resolved to current names when the log is read, so somebody who
  /// changed their display name reads back as who they are now.
  peerIds       String[]  @default([])
  /// Bytes sent and received across every peer connection of this call, as the
  /// client counted them - nothing else is in the media path to count. Zero
  /// when the client never got to report, which a window closed mid-call does.
  bytes         BigInt    @default(0)
  /// The same total split by direction. Kept beside `bytes` rather than derived
  /// from it because an older client reports only the total, and a split that
  /// guessed at halves would read as measurement rather than as the guess it is.
  bytesSent     BigInt    @default(0)
  bytesReceived BigInt    @default(0)
  /// One entry per person this client held a peer connection to: what that link
  /// moved, how it got there (direct or through a relay), its round trip and its
  /// loss. A `CallLinkReport[]` from shared-types, written verbatim after
  /// clamping - see `usage.ts`.
  ///
  /// ponytail: JSON rather than a table. It is read whole, per row, by the one
  /// person it belongs to, and nothing ever queries across it. A join table is
  /// the upgrade if a report is ever wanted for a whole deployment.
  links         Json?

  user User @relation("CallSessionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, joinedAt])
  @@map("call_sessions")
}

// --- Status (phase 30) --------------------------------------------------------
//
// A status is a post that expires. It is deliberately not a message: it has no
// channel, no conversation to belong to, no reply, and its audience is a set
// (accepted friends) rather than a room. Modelling it as a message in a hidden
// channel would have meant a channel per account, a membership row per friend
// kept in step with the friend list, and a message table where half the rows
// are not messages.
//
// **End-to-end encrypted, with the audience frozen at post time.** Sealing a
// post with no channel means choosing between re-wrapping a key for every new
// friendship and freezing the audience when it is written; freezing is the
// choice, and it is also the behaviour that was wanted - somebody who becomes
// your friend tomorrow does not see what you posted today. `status_keys` holds
// one wrap per recipient device and *is* the audience: no row, no key, nothing
// to read. See `docs/docs/security/e2ee.md`.

/// What a status is made of.
enum StatusKind {
  PHOTO
  VIDEO
  /// No media at all: a caption drawn on a colour, which is the third thing
  /// WhatsApp lets you post and the one that needs no upload.
  TEXT
}

/// One post, alive for 24 hours.
model Status {
  id         String     @id @default(uuid())
  authorId   String
  kind       StatusKind
  /// The storage key of the photo or video, rooted at `status/<authorId>/`.
  /// Null for TEXT. The `status/` prefix is what the download route reads to
  /// know this object is gated by friendship rather than by channel access.
  mediaKey   String?
  /// The IV the media was sealed with, base64. Null for TEXT.
  mediaIv    String?
  /// What the sealed bytes are once opened - `image/jpeg`, `video/mp4`. In the
  /// clear on purpose: the server holds ciphertext and cannot sniff it, and a
  /// client needs a type to hand the decoder.
  mediaType  String?
  /// The caption under a photo, or the whole of a TEXT status, sealed: an
  /// `EncryptedEnvelope` as JSON, never the words. Capped by the DTO at
  /// STATUS_CAPTION_SEALED_MAX_LENGTH, which is the only cap a ciphertext has.
  caption    String?
  /// The colour a TEXT status is drawn on, as a CSS hex the client picked from
  /// a fixed palette. Null for media, which is its own background.
  background String?
  /// How long a video runs, in milliseconds, as the client measured it. It is
  /// what times the progress bar; a photo uses the client's fixed step and
  /// leaves this null.
  durationMs Int?
  createdAt  DateTime   @default(now())
  /// createdAt + 24h, stamped at write time for the same reason a disappearing
  /// message stamps its own: the sweep then has nothing to decide.
  expiresAt  DateTime

  author User         @relation("StatusAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  views  StatusView[]
  keys   StatusKey[]

  /// The feed reads one author's live posts, oldest first.
  @@index([authorId, createdAt])
  /// The sweep reads what is past its stamp.
  @@index([expiresAt])
  @@map("statuses")
}

/// One status key, sealed for one device.
///
/// This table is the audience, and that is the whole of the design: a status
/// has no channel to inherit membership from, so the author wraps its key for
/// every device of every friend it had *at the moment it was posted*. A
/// friendship made afterwards adds no row, which is why a new friend does not
/// see yesterday's post - the same rule every app with this feature has, here
/// enforced by arithmetic rather than by a query the server is trusted to run.
///
/// No epoch, unlike `ChannelKey`: a status is written once and gone in a day,
/// so there is nothing to rotate.
model StatusKey {
  id                String   @id @default(uuid())
  statusId          String
  recipientUserId   String
  /// Which of that user's devices this copy is sealed for. One row per device.
  recipientDeviceId String
  /// Which machine did the sealing, so a wrap can be attributed after the fact.
  senderDeviceId    String
  senderPublicKey   String
  wrappedKey        String
  iv                String
  createdAt         DateTime @default(now())

  status Status @relation(fields: [statusId], references: [id], onDelete: Cascade)

  @@unique([statusId, recipientDeviceId])
  /// The tray asks "which live posts is there a wrap for me on".
  @@index([recipientUserId])
  @@map("status_keys")
}

/// Somebody opened somebody else's status.
///
/// One row per pair, not one per open: "seen" is a fact, and a table that grew
/// a row every time a story was re-opened would be a view counter nobody asked
/// for. The author reads these as the viewer list; every other account can
/// only ever read its own.
model StatusView {
  id       String   @id @default(uuid())
  statusId String
  viewerId String
  viewedAt DateTime @default(now())

  status Status @relation(fields: [statusId], references: [id], onDelete: Cascade)
  viewer User   @relation("StatusViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([statusId, viewerId])
  @@index([viewerId])
  @@map("status_views")
}

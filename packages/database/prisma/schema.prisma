// MVP schema. One schema shared by auth-, server- and chat-service; each
// service touches only the models it owns. Splitting per service is tracked in
// development/TODO.md (cross-cutting debt).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServerRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
  GUEST
}

enum ChannelType {
  TEXT
  VOICE
  /// A direct message between two people. It is a channel with no server, so
  /// history, paging, realtime fanout and encryption are the ones that already
  /// exist - see development/PLANNING.md (phase 12).
  DM
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

/// Platform-wide role, distinct from ServerRole: ADMIN grants the admin
/// panel, not membership rights inside any server.
enum GlobalRole {
  USER
  ADMIN
}

model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  username           String     @unique
  displayName        String
  passwordHash       String
  avatarUrl          String?
  role               GlobalRole @default(USER)
  /// Set for accounts created with a generated password (the bootstrap admin);
  /// they can do nothing until they choose their own.
  mustChangePassword Boolean    @default(false)
  /// A disabled account keeps its data but cannot log in or refresh.
  disabledAt         DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  refreshTokens RefreshToken[]
  ownedServers  Server[]        @relation("ServerOwner")
  memberships   ServerMember[]
  channelSeats  ChannelMember[]
  friendshipsA  Friendship[]    @relation("FriendshipA")
  friendshipsB  Friendship[]    @relation("FriendshipB")
  messages        Message[]
  deletedMessages Message[]         @relation("MessageDeletedBy")
  pinnedMessages  Message[]         @relation("MessagePinnedBy")
  reactions       MessageReaction[]
  deviceKey     DeviceKey?
  identityBackup IdentityBackup?
  identities    UserIdentity[]
  notifications NotificationSetting?
  channelReads  ChannelRead[]
  remoteMachines RemoteMachine[] @relation("RemoteMachineOwner")
  remoteGrants   RemoteGrant[]   @relation("RemoteGrantUser")
  remoteGranted  RemoteGrant[]   @relation("RemoteGrantGrantedBy")
  remoteSessions RemoteSession[] @relation("RemoteSessionUser")
  remoteAudit    RemoteAudit[]   @relation("RemoteAuditActor")

  @@map("users")
}

/// Per-account notification settings, owned by notification-service. One row
/// per user, written the first time anything is changed - an account with no
/// row is an account with the defaults.
model NotificationSetting {
  userId String @id
  /// Off entirely; the client raises nothing while this is false.
  enabled Boolean @default(true)
  /// Quiet hours as minutes from midnight on the client's own clock, so the
  /// server never has to know a timezone. Null on either end means no quiet
  /// hours. A window is allowed to wrap midnight (start 1320, end 480).
  quietStartMinute Int?
  quietEndMinute   Int?
  /// Channels this account never wants raised.
  /// ponytail: an array column, not a join table - the list is small and is
  /// only ever read whole. Split it out when a mute grows its own settings.
  mutedChannelIds String[] @default([])
  /// Channels that only raise a notification when this account is mentioned -
  /// the middle setting between everything and nothing, and the one a busy
  /// server actually needs. A channel in both lists is silent: the stronger
  /// setting wins, so a mute is never weakened by another list.
  ///
  /// Whether a message mentions somebody is decided on the client, because the
  /// server cannot read it: bodies are sealed with the channel key and this
  /// service stores a preference, not a message.
  mentionOnlyChannelIds String[] @default([])
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

/// How far a user has read a channel. Unread counts are derived from it rather
/// than stored, so they survive a restart and follow the account to another
/// machine instead of living in one client's memory.
model ChannelRead {
  userId     String
  channelId  String
  lastReadAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@index([channelId])
  @@map("channel_reads")
}

/// A third-party login linked to an account. The provider's own user id is what
/// identifies the person on the next login; email can change on their side.
model UserIdentity {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("user_identities")
}

/// OAuth provider credentials, configured from the admin panel rather than the
/// environment, so enabling a login is an operator action and not a redeploy.
/// `clientSecret` is stored sealed - see packages/auth `sealSecret`.
model OAuthProvider {
  provider     String   @id
  enabled      Boolean  @default(false)
  clientId     String
  clientSecret String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("oauth_providers")
}

/// Public half of a user's end-to-end encryption identity key (ECDH P-256, JWK).
/// The private half never leaves the device in the clear; the server publishes
/// this only so members can wrap channel keys for each other. The same identity
/// is restored on every machine the account signs in on - see IdentityBackup.
model DeviceKey {
  userId    String   @id
  publicKey String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_keys")
}

/// The identity private key, sealed on the client with a key derived from a
/// secret the server never receives (PBKDF2 over the account password, or over
/// a passphrase the user set). Without it, wiping an installation - or signing
/// in on a second machine - meant a new identity and a history nobody could
/// open. The server stores the blob and hands it back to its owner; it holds
/// nothing that opens it.
model IdentityBackup {
  userId     String   @id
  version    Int      @default(1)
  /// "password" or "passphrase": what the client must ask the user for.
  kind       String
  kdf        String
  iterations Int
  salt       String
  iv         String
  ciphertext String
  /// Public half of the sealed pair, so a client can recognise a stale backup.
  publicKey  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("identity_backups")
}

/// A channel's symmetric content key, wrapped once per recipient. The server
/// stores only ciphertext it cannot open: `wrappedKey` is sealed with the ECDH
/// secret between `senderPublicKey` and the recipient's device key.
model ChannelKey {
  id              String   @id @default(uuid())
  channelId       String
  epoch           Int
  recipientUserId String
  senderUserId    String
  senderPublicKey String
  wrappedKey      String
  iv              String
  createdAt       DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, epoch, recipientUserId])
  @@index([channelId, recipientUserId])
  @@map("channel_keys")
}

model RefreshToken {
  // `id` is the JWT `jti`, so revoking a token is a delete by id.
  id        String    @id
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Server {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  iconUrl   String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User           @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  ServerMember[]
  channels Channel[]

  @@index([ownerId])
  @@map("servers")
}

model ServerMember {
  id                 String     @id @default(uuid())
  serverId           String
  userId             String
  role               ServerRole @default(MEMBER)
  /// Permissions this member holds beyond the role's defaults, so an
  /// administrator can hand one person one capability without inventing a role.
  grantedPermissions String[]   @default([])
  /// Permissions withheld even though the role would grant them. Deny wins.
  deniedPermissions  String[]   @default([])
  joinedAt           DateTime   @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([userId])
  @@map("server_members")
}

model Channel {
  id        String      @id @default(uuid())
  /// Null for a direct message, which belongs to its two participants rather
  /// than to a server.
  serverId  String?
  name      String
  type      ChannelType @default(TEXT)
  topic     String?
  /// A private channel is visible only to the users listed in `members`. Server
  /// membership grants nothing here - not even to an administrator, who has to
  /// be added like anyone else. See development/PLANNING.md (phase 12).
  isPrivate Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  server   Server?         @relation(fields: [serverId], references: [id], onDelete: Cascade)
  members  ChannelMember[]
  messages Message[]
  keys     ChannelKey[]
  reads    ChannelRead[]

  @@unique([serverId, name])
  @@map("channels")
}

/// One row per user allowed into a private channel. Rows on a public channel
/// are ignored, so making a channel private later needs no backfill.
model ChannelMember {
  id        String   @id @default(uuid())
  channelId String
  userId    String
  addedAt   DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@map("channel_members")
}

/// One row per relationship, not one per direction: a request and a friendship
/// are the same thing in two states. The pair is stored with the lower user id
/// first so the unique constraint catches two people requesting each other.
model Friendship {
  id          String           @id @default(uuid())
  userAId     String
  userBId     String
  /// Who sent the request. Only the other side may accept it.
  requesterId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  userA User @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("friendships")
}

model Message {
  id        String    @id @default(uuid())
  channelId String
  authorId  String
  // Opaque to the server: clients store a serialised `EncryptedEnvelope` here.
  content   String
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?
  /// Who deleted it, when that was not the author - a client shows "deleted by
  /// NAME" rather than pretending the author took it back.
  deletedById String?
  pinnedAt    DateTime?
  pinnedById  String?

  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  deletedBy User?   @relation("MessageDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  pinnedBy  User?   @relation("MessagePinnedBy", fields: [pinnedById], references: [id], onDelete: SetNull)
  reactions MessageReaction[]

  // History paging reads newest-first within a channel.
  @@index([channelId, createdAt])
  // The pinned panel lists one channel's pins, newest pin first.
  @@index([channelId, pinnedAt])
  @@map("messages")
}

/// One person's one emoji on one message.
///
/// The emoji is stored in the clear, unlike everything else about a message.
/// That is a deliberate, documented leak (see development/E2EE.md): the server
/// has to group and count reactions for people who hold no channel key at the
/// moment they ask, and an encrypted-per-recipient reaction would cost a key
/// exchange per thumbs-up.
model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

// --- Remote desktop (phase 17) ------------------------------------------------
//
// Kept apart from chat and media on purpose: a remote session is the most
// dangerous thing this platform can do, so it has its own service, its own
// permission set that no role grants by default, and its own audit trail.

/// A machine that has enrolled an agent. The agent connects outbound to
/// remote-gateway; nothing ever dials the machine, and no inbound port is
/// opened on it.
model RemoteMachine {
  id       String @id @default(uuid())
  /// Whoever enrolled it. The owner always has every remote permission on it
  /// and is the only one who may hand them out.
  ownerId  String
  name     String
  platform String

  /// The agent's credential, stored as a SHA-256 hash the way a password is.
  /// It is shown once, at enrolment, and rotated by enrolling again.
  ///
  /// ponytail: a shared secret, not a device keypair. It is what cloudflared
  /// and every other outbound agent uses; a signed handshake is the upgrade if
  /// a stolen token at rest ever becomes the threat that matters.
  ///
  /// Unique, and indexed by being so: an agent connecting is one lookup rather
  /// than a scan of every machine's hash.
  agentTokenHash String @unique
  /// Null until the agent has connected once.
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  owner    User            @relation("RemoteMachineOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  grants   RemoteGrant[]
  sessions RemoteSession[]
  audit    RemoteAudit[]

  @@index([ownerId])
  @@map("remote_machines")
}

/// What one person may do to one machine. Absent means no access at all -
/// remote permissions are never implied by a server role.
model RemoteGrant {
  id        String @id @default(uuid())
  machineId String
  userId    String
  /// REMOTE_VIEW, REMOTE_CONTROL, REMOTE_FILE_TRANSFER, REMOTE_CLIPBOARD,
  /// REMOTE_AUDIO, REMOTE_ADMIN. Unknown strings are ignored when resolving,
  /// so a row written by a newer build cannot break an older one.
  permissions String[] @default([])
  /// Temporary access: past this moment the grant resolves to nothing. Null is
  /// open-ended.
  expiresAt DateTime?
  grantedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  machine   RemoteMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  user      User          @relation("RemoteGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?         @relation("RemoteGrantGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([machineId, userId])
  @@index([userId])
  @@map("remote_grants")
}

/// One connection from one person to one machine. The permissions are frozen
/// when it starts, so revoking a grant mid-session is a decision the gateway
/// takes deliberately (it ends the session) rather than an accident of timing.
model RemoteSession {
  id          String    @id @default(uuid())
  machineId   String
  userId      String
  permissions String[]  @default([])
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  /// Why it stopped: "controller", "agent", "revoked", "agent-offline".
  endedReason String?

  machine RemoteMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  user    User          @relation("RemoteSessionUser", fields: [userId], references: [id], onDelete: Cascade)
  audit   RemoteAudit[]

  @@index([machineId, startedAt])
  @@index([userId, startedAt])
  @@map("remote_sessions")
}

/// Append-only record of everything that happened to a machine. Nothing here is
/// ever updated or deleted by the application; a machine's owner can read it.
model RemoteAudit {
  id        String  @id @default(uuid())
  machineId String
  sessionId String?
  /// Who did it. Null when it was the agent itself rather than a person.
  actorId String?
  /// machine.enrolled, machine.renamed, permission.changed, session.started,
  /// session.ended, session.refused.
  action String
  detail Json?

  createdAt DateTime @default(now())

  machine RemoteMachine  @relation(fields: [machineId], references: [id], onDelete: Cascade)
  session RemoteSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  actor   User?          @relation("RemoteAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([machineId, createdAt])
  @@map("remote_audit")
}

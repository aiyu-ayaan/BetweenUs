// MVP schema. One schema shared by auth-, workspace- and chat-service; each
// service touches only the models it owns. Splitting per service is tracked in
// development/TODO.md (cross-cutting debt).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
  GUEST
}

enum ChannelType {
  TEXT
  VOICE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  displayName  String
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens    RefreshToken[]
  ownedWorkspaces  Workspace[]       @relation("WorkspaceOwner")
  memberships      WorkspaceMember[]
  messages         Message[]

  @@map("users")
}

model RefreshToken {
  // `id` is the JWT `jti`, so revoking a token is a delete by id.
  id        String   @id
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  iconUrl   String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members  WorkspaceMember[]
  channels Channel[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Channel {
  id          String      @id @default(uuid())
  workspaceId String
  name        String
  type        ChannelType @default(TEXT)
  topic       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([workspaceId, name])
  @@map("channels")
}

model Message {
  id        String    @id @default(uuid())
  channelId String
  authorId  String
  content   String
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // History paging reads newest-first within a channel.
  @@index([channelId, createdAt])
  @@map("messages")
}
